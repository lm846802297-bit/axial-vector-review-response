{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:research-result-data-standard:v1.0.1:record",
  "title": "Research Result Data Standard record v1.0.1 (v1.0.0 compatibility superset)",
  "oneOf": [
    {
      "$ref": "#/$defs/run_manifest"
    },
    {
      "$ref": "#/$defs/result_summary"
    },
    {
      "$ref": "#/$defs/validation_report"
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "project_id"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "workstream_id": {
          "type": "string",
          "minLength": 1
        },
        "research_change_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "file_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "role",
        "format",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "rows": {
          "type": "integer",
          "minimum": 0
        },
        "records": {
          "type": "integer",
          "minimum": 0
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "units": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "source_run_id": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "version": {
          "type": "string"
        },
        "access": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "format": {
                "const": "csv"
              }
            },
            "required": [
              "format"
            ]
          },
          "then": {
            "required": [
              "rows",
              "columns",
              "units"
            ]
          }
        }
      ]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "name",
        "category",
        "status"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "analytic",
            "unit",
            "software",
            "regression",
            "convergence",
            "independent",
            "physical",
            "integrity",
            "other"
          ]
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "partial",
            "not_run",
            "blocked",
            "inconclusive",
            "stale"
          ]
        },
        "method": {
          "type": "string"
        },
        "observed": {
          "type": [
            "number",
            "string",
            "null"
          ]
        },
        "threshold": {
          "type": [
            "number",
            "string",
            "null"
          ]
        },
        "unit": {
          "type": "string"
        },
        "evidence_path": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "run_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_type",
        "run_id",
        "created_at",
        "project",
        "source",
        "inputs",
        "configuration",
        "environment",
        "execution",
        "outputs",
        "validation",
        "archive"
      ],
      "properties": {
        "schema_version": {
          "enum": [
            "1.0.0",
            "1.0.1"
          ]
        },
        "record_type": {
          "const": "run_manifest"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,80}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "project": {
          "$ref": "#/$defs/project"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "commit_sha",
            "script_path",
            "script_sha256"
          ],
          "properties": {
            "commit_sha": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "branch": {
              "type": "string"
            },
            "script_path": {
              "type": "string",
              "minLength": 1
            },
            "script_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "workflow_path": {
              "type": "string"
            },
            "workflow_run_id": {
              "type": [
                "string",
                "integer"
              ]
            }
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "source",
              "format"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "uri": {
                "type": "string",
                "format": "uri"
              },
              "format": {
                "type": "string",
                "minLength": 1
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "access": {
                "type": "string"
              },
              "transformation": {
                "type": "string"
              }
            },
            "allOf": [
              {
                "if": {
                  "required": [
                    "path"
                  ]
                },
                "then": {
                  "required": [
                    "sha256",
                    "bytes"
                  ]
                }
              },
              {
                "if": {
                  "not": {
                    "required": [
                      "path"
                    ]
                  }
                },
                "then": {
                  "required": [
                    "uri",
                    "version"
                  ]
                }
              }
            ]
          }
        },
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "physics",
            "numerics",
            "conventions"
          ],
          "properties": {
            "physics": {
              "type": "object"
            },
            "numerics": {
              "type": "object"
            },
            "conventions": {
              "type": "object"
            }
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "platform",
            "runtime",
            "dependencies",
            "hardware"
          ],
          "properties": {
            "platform": {
              "type": "string",
              "minLength": 1
            },
            "runtime": {
              "type": "object"
            },
            "dependencies": {
              "type": "object"
            },
            "hardware": {
              "type": "object"
            }
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "command",
            "started_at",
            "finished_at"
          ],
          "properties": {
            "status": {
              "enum": [
                "not_started",
                "running",
                "succeeded",
                "partial",
                "failed",
                "cancelled",
                "blocked"
              ]
            },
            "command": {
              "type": "string"
            },
            "started_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "finished_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "exit_code": {
              "type": [
                "integer",
                "null"
              ]
            },
            "wall_time_s": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "source_control": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "event",
                "checkout_mode",
                "checkout_ref",
                "pr_number",
                "pr_url",
                "pr_head_sha",
                "base_sha",
                "tested_merge_sha",
                "head_ref",
                "base_ref",
                "workflow_run_id",
                "workflow_run_attempt",
                "working_tree_state",
                "dirty_paths"
              ],
              "properties": {
                "event": {
                  "type": "string",
                  "minLength": 1
                },
                "checkout_mode": {
                  "enum": [
                    "pull_request_merge",
                    "pull_request_head",
                    "pull_request_base",
                    "branch_commit",
                    "detached_commit",
                    "unknown"
                  ]
                },
                "checkout_ref": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "pattern": "^refs/"
                },
                "pr_number": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "pr_url": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "uri"
                },
                "pr_head_sha": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[a-f0-9]{40}$"
                },
                "base_sha": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[a-f0-9]{40}$"
                },
                "tested_merge_sha": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[a-f0-9]{40}$"
                },
                "head_ref": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "base_ref": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "workflow_run_id": {
                  "type": [
                    "string",
                    "integer",
                    "null"
                  ]
                },
                "workflow_run_attempt": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "working_tree_state": {
                  "enum": [
                    "clean",
                    "dirty",
                    "unknown"
                  ]
                },
                "dirty_paths": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "uniqueItems": true
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "event": {
                        "enum": [
                          "pull_request",
                          "pull_request_target"
                        ]
                      }
                    },
                    "required": [
                      "event"
                    ]
                  },
                  "then": {
                    "properties": {
                      "pr_number": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "pr_url": {
                        "type": "string",
                        "format": "uri"
                      },
                      "pr_head_sha": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{40}$"
                      },
                      "base_sha": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{40}$"
                      },
                      "head_ref": {
                        "type": "string",
                        "minLength": 1
                      },
                      "base_ref": {
                        "type": "string",
                        "minLength": 1
                      },
                      "checkout_mode": {
                        "enum": [
                          "pull_request_merge",
                          "pull_request_head",
                          "pull_request_base",
                          "unknown"
                        ]
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "pr_number": {
                        "type": "null"
                      },
                      "pr_url": {
                        "type": "null"
                      },
                      "pr_head_sha": {
                        "type": "null"
                      },
                      "base_sha": {
                        "type": "null"
                      },
                      "tested_merge_sha": {
                        "type": "null"
                      },
                      "head_ref": {
                        "type": "null"
                      },
                      "base_ref": {
                        "type": "null"
                      },
                      "checkout_mode": {
                        "enum": [
                          "branch_commit",
                          "detached_commit",
                          "unknown"
                        ]
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "checkout_mode": {
                        "const": "pull_request_merge"
                      }
                    },
                    "required": [
                      "checkout_mode"
                    ]
                  },
                  "then": {
                    "properties": {
                      "tested_merge_sha": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{40}$"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "checkout_mode": {
                        "enum": [
                          "pull_request_head",
                          "pull_request_base",
                          "unknown"
                        ]
                      }
                    },
                    "required": [
                      "checkout_mode"
                    ]
                  },
                  "then": {
                    "properties": {
                      "tested_merge_sha": {
                        "type": "null"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "workflow_run_id": {
                        "type": "null"
                      }
                    },
                    "required": [
                      "workflow_run_id"
                    ]
                  },
                  "then": {
                    "properties": {
                      "workflow_run_attempt": {
                        "type": "null"
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "workflow_run_attempt": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "working_tree_state": {
                        "const": "clean"
                      }
                    },
                    "required": [
                      "working_tree_state"
                    ]
                  },
                  "then": {
                    "properties": {
                      "dirty_paths": {
                        "maxItems": 0
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "working_tree_state": {
                        "const": "dirty"
                      }
                    },
                    "required": [
                      "working_tree_state"
                    ]
                  },
                  "then": {
                    "properties": {
                      "dirty_paths": {
                        "minItems": 1
                      }
                    }
                  }
                }
              ]
            }
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file_record"
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "checks"
          ],
          "properties": {
            "status": {
              "enum": [
                "not_run",
                "partial",
                "passed",
                "failed",
                "blocked",
                "inconclusive"
              ]
            },
            "checks": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/check"
              }
            },
            "report_path": {
              "type": "string"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "passed"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "properties": {
                  "checks": {
                    "minItems": 1,
                    "items": {
                      "properties": {
                        "status": {
                          "const": "passed"
                        }
                      },
                      "required": [
                        "status"
                      ]
                    }
                  }
                }
              }
            }
          ]
        },
        "archive": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "local_only",
                "committed_to_pr_branch",
                "merged_and_verified_on_main"
              ]
            },
            "pr_url": {
              "type": "string",
              "format": "uri"
            },
            "verified_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "committed_to_pr_branch"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "required": [
                  "pr_url"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "merged_and_verified_on_main"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "required": [
                  "verified_at"
                ]
              }
            }
          ]
        },
        "extensions": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "schema_version": {
                "const": "1.0.1"
              }
            },
            "required": [
              "schema_version"
            ]
          },
          "then": {
            "properties": {
              "execution": {
                "required": [
                  "status",
                  "command",
                  "started_at",
                  "finished_at",
                  "source_control"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "execution": {
                "not": {
                  "required": [
                    "source_control"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "result_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_type",
        "run_id",
        "created_at",
        "project",
        "calculation",
        "scope",
        "benchmark",
        "observables",
        "data_files",
        "scientific_status"
      ],
      "properties": {
        "schema_version": {
          "enum": [
            "1.0.0",
            "1.0.1"
          ]
        },
        "record_type": {
          "const": "result_summary"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,80}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "project": {
          "$ref": "#/$defs/project"
        },
        "calculation": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "included",
            "excluded"
          ],
          "properties": {
            "included": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "excluded": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "assumptions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "benchmark": {
          "type": "object"
        },
        "observables": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "value",
              "unit",
              "status"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "definition": {
                "type": "string"
              },
              "uncertainty": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "dimensions": {
                "type": "object"
              },
              "status": {
                "enum": [
                  "computed",
                  "not_computed",
                  "not_applicable"
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "computed"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "properties": {
                    "value": {
                      "type": "number"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "enum": [
                        "not_computed",
                        "not_applicable"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "properties": {
                    "value": {
                      "type": "null"
                    }
                  }
                }
              }
            ]
          }
        },
        "data_files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file_record"
          }
        },
        "scientific_status": {
          "enum": [
            "diagnostic",
            "provisional",
            "reproducible",
            "validated",
            "historical",
            "superseded"
          ]
        },
        "interpretation": {
          "type": "string"
        },
        "extensions": {
          "type": "object"
        }
      }
    },
    "validation_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_type",
        "run_id",
        "created_at",
        "status",
        "checks"
      ],
      "properties": {
        "schema_version": {
          "enum": [
            "1.0.0",
            "1.0.1"
          ]
        },
        "record_type": {
          "const": "validation_report"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,80}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "enum": [
            "not_run",
            "partial",
            "passed",
            "failed",
            "blocked",
            "inconclusive"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "convergence": {
          "type": "object"
        },
        "extensions": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "passed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "checks": {
                "minItems": 1,
