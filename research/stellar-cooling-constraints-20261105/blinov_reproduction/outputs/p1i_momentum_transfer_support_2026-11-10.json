      "total": "integral_{q<qcut} d sigma / integral d sigma",
      "angular_transport": "integral_{q<qcut} (1-cos(theta)) d sigma / integral (1-cos(theta)) d sigma",
      "energy_loss": "integral_{q<qcut} (1-Eprime/E) d sigma / integral (1-Eprime/E) d sigma"
    },
